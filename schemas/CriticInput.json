{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "source_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CompanyFeature": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "COMPANY_FEATURE",
          "title": "Kind",
          "type": "string"
        },
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "feature_id": {
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "client_id",
        "feature_id",
        "value",
        "source_record_id"
      ],
      "title": "CompanyFeature",
      "type": "object"
    },
    "ComputedEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "COMPUTED_VALUE",
          "title": "Kind",
          "type": "string"
        },
        "formula_id": {
          "pattern": "^FM-(0[1-9]|1[0-9]|2[0-4])$",
          "title": "Formula Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "input_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Ids",
          "type": "array"
        },
        "calculation_ref": {
          "minLength": 1,
          "title": "Calculation Ref",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "formula_id",
        "value",
        "input_ids",
        "calculation_ref"
      ],
      "title": "ComputedEvidence",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "news",
            "bank"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "is_mock": {
          "default": false,
          "title": "Is Mock",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "Document",
      "type": "object"
    },
    "EvidenceLedger": {
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "client_id": {
          "minLength": 1,
          "title": "Client Id",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/Document"
          },
          "title": "Documents",
          "type": "array"
        },
        "entries": {
          "items": {
            "discriminator": {
              "mapping": {
                "BANK_VIEW": "#/$defs/QuotedEvidence",
                "COMPANY_FEATURE": "#/$defs/CompanyFeature",
                "COMPUTED_VALUE": "#/$defs/ComputedEvidence",
                "NEWS_FACT": "#/$defs/QuotedEvidence"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/QuotedEvidence"
              },
              {
                "$ref": "#/$defs/CompanyFeature"
              },
              {
                "$ref": "#/$defs/ComputedEvidence"
              }
            ]
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "trace_id",
        "client_id",
        "event_id",
        "documents",
        "entries"
      ],
      "title": "EvidenceLedger",
      "type": "object"
    },
    "Inference": {
      "additionalProperties": false,
      "properties": {
        "impact_chain": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Impact Chain",
          "type": "array"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Risks",
          "type": "array"
        },
        "opportunities": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Opportunities",
          "type": "array"
        },
        "actions_or_questions": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Actions Or Questions",
          "type": "array"
        },
        "confidence": {
          "description": "Copied from code FM-20",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "impact_chain",
        "risks",
        "opportunities",
        "actions_or_questions",
        "confidence"
      ],
      "title": "Inference",
      "type": "object"
    },
    "InsightCard": {
      "additionalProperties": false,
      "properties": {
        "confirmed_facts": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Confirmed Facts",
          "type": "array"
        },
        "why_you": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Why You",
          "type": "array"
        },
        "bank_view_status": {
          "enum": [
            "available",
            "missing",
            "outdated",
            "conflict"
          ],
          "title": "Bank View Status",
          "type": "string"
        },
        "bank_view_items": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Bank View Items",
          "type": "array"
        },
        "model_inference": {
          "$ref": "#/$defs/Inference"
        },
        "provenance_labels": {
          "additionalProperties": {
            "enum": [
              "fact",
              "bank_view",
              "ai_inference"
            ],
            "type": "string"
          },
          "title": "Provenance Labels",
          "type": "object"
        },
        "relevance": {
          "description": "Copied from DA code",
          "maximum": 1,
          "minimum": 0,
          "title": "Relevance",
          "type": "number"
        },
        "offer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offer"
        },
        "disclaimer": {
          "minLength": 1,
          "title": "Disclaimer",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "confirmed_facts",
        "bank_view_status",
        "bank_view_items",
        "model_inference",
        "provenance_labels",
        "relevance",
        "disclaimer",
        "trace_id"
      ],
      "title": "InsightCard",
      "type": "object"
    },
    "QuotedEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "NEWS_FACT",
            "BANK_VIEW"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Span"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "id",
        "kind",
        "source"
      ],
      "title": "QuotedEvidence",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "start",
        "end",
        "quote"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "card": {
      "$ref": "#/$defs/InsightCard"
    },
    "impacts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Impacts",
      "type": "array"
    },
    "ledger": {
      "$ref": "#/$defs/EvidenceLedger"
    },
    "computed": {
      "additionalProperties": true,
      "title": "Computed",
      "type": "object"
    },
    "scope": {
      "default": "card",
      "enum": [
        "card",
        "dialogue"
      ],
      "title": "Scope",
      "type": "string"
    },
    "question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question"
    }
  },
  "required": [
    "card",
    "impacts",
    "ledger",
    "computed"
  ],
  "title": "CriticInput",
  "type": "object"
}
