# ---- identification toward news sources (SRC-03 asks who is calling; see OQ-11) ----
NAFA_CONTACT=team@example.invalid

# ---- storage ----
# relative paths are resolved against the project folder. Default DB file = <project>/data/nafa.db
# (inside Docker compose these are overridden to /data/nafa.db on a named volume)
NAFA_DB_PATH=data/nafa.db
NAFA_DATA_DIR=data

# ---- security ----
# secret for pseudonymising client IDs in logs/prompts (any long random string)
NAFA_PSEUDONYM_SALT=change-me
# token for admin-only endpoints (POST /bank-view, /sources/check)
NAFA_ADMIN_TOKEN=change-me

# ---- LLM gateway (OpenAI-compatible endpoint issued by organisers; OQ-05/OQ-10) ----
LLM_BASE_URL=
LLM_API_KEY=
