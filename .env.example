# Shared organiser endpoint; use the backend LLMGateway when integrating.
LLM_BASE_URL=
LLM_API_KEY=
# Run via: uv run --env-file .env --extra backend python -m pe.run live ...
# Optional absolute directory containing confirmed models.yaml/settings.yaml:
# NAFA_CONFIG_DIR=/absolute/path/to/config
# For an installed approved local model server, use --local and for example:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY can be empty in this explicit local mode.
